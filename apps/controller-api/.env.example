# Chave que o bot usa para autenticar no controller (deve ser igual nos dois .env)
CONTROLLER_API_KEY=change-me-controller-key

# Pasta de dados (tarefas, logs, policy)
DATA_DIR=../../data

# Porta do servidor (padrão: 8000)
PORT=8000

# Token do Telegram — necessário para o controller notificar resultado do OpenHands
# (mesmo token do bot; nunca commite)
TELEGRAM_BOT_TOKEN=REPLACE_ME

# URL do OpenHands quando rodando (vendor/openhands/docker-compose.yml)
OPENHANDS_URL=http://127.0.0.1:3000
