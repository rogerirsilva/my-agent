# Chave de API do LLM (ex: OpenAI, Anthropic, etc.)
OPENHANDS_LLM_API_KEY=REPLACE_ME

# Modelo a usar (exemplos abaixo — descomente o que preferir)
OPENHANDS_LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
# OPENHANDS_LLM_MODEL=openai/gpt-4o
# OPENHANDS_LLM_MODEL=openai/gpt-4o-mini

# Pasta de trabalho do agente (padrão: data/openhands-workspace)
# WORKSPACE_DIR=../../data/openhands-workspace

# Base URL personalizada (para modelos locais via Ollama, LM Studio, etc.)
# OPENHANDS_LLM_BASE_URL=http://host.docker.internal:11434/v1
