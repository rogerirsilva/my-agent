# === ESCOLHA UM DOS BLOCOS ABAIXO E DESCOMENTE ===

# ─────────────────────────────────────────────────────
# OPÇÃO A — Groq (FREE, sem GPU, muito rápido) ← RECOMENDADO
# Cadastro: https://console.groq.com  (free tier generoso)
# Modelos: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# ─────────────────────────────────────────────────────
OPENHANDS_LLM_MODEL=groq/llama-3.3-70b-versatile
OPENHANDS_LLM_API_KEY=REPLACE_ME_GROQ_KEY
# OPENHANDS_LLM_BASE_URL=   (não precisa para Groq)


# ─────────────────────────────────────────────────────
# OPÇÃO B — Google Gemini (FREE tier generoso)
# Cadastro: https://aistudio.google.com  → Get API Key
# ─────────────────────────────────────────────────────
# OPENHANDS_LLM_MODEL=gemini/gemini-2.0-flash
# OPENHANDS_LLM_API_KEY=REPLACE_ME_GEMINI_KEY


# ─────────────────────────────────────────────────────
# OPÇÃO C — Ollama LOCAL (sem API key, sem custo, roda no seu PC)
# Requer: ~8GB RAM para modelos 7B (GPU ajuda mas não é obrigatório)
# Inicia com: docker compose --profile ollama up -d
# ─────────────────────────────────────────────────────
# OPENHANDS_LLM_MODEL=ollama/llama3.2
# OPENHANDS_LLM_API_KEY=ollama
# OPENHANDS_LLM_BASE_URL=http://ollama:11434


# ─────────────────────────────────────────────────────
# OPÇÃO D — OpenRouter (modelos :free — lista muda frequentemente)
# Verifique disponíveis em: https://openrouter.ai/models?q=free
# Atualmente funcionais: google/gemini-2.0-flash-exp:free
# meta-llama/llama-3.3-70b-instruct:free (disponibilidade instável)
# ─────────────────────────────────────────────────────
# OPENHANDS_LLM_MODEL=openrouter/google/gemini-2.0-flash-exp:free
# OPENHANDS_LLM_API_KEY=REPLACE_ME_OPENROUTER_KEY
# OPENHANDS_LLM_BASE_URL=https://openrouter.ai/api/v1


# Pasta de workspace do agente (criada automaticamente)
# WORKSPACE_DIR=../../data/openhands-workspace
