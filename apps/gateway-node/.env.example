# NUNCA commite o token real
TELEGRAM_BOT_TOKEN=REPLACE_ME
ALLOWED_TELEGRAM_USER_ID=210623701

# Segredo para autorizar /exec (inventar uma senha forte, nunca o token do Telegram)
BOT_SHARED_SECRET=change-me

# Controller API — deve bater com apps/controller-api/.env
CONTROLLER_API_URL=http://127.0.0.1:8000
CONTROLLER_API_KEY=change-me-controller-key

# Pasta de dados (logs, tarefas)
DATA_DIR=../../data